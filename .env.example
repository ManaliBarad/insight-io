# Copy to .env.local to override. All values are optional.

# rosbridge websocket (ros2 launch rosbridge_server rosbridge_websocket_launch.xml)
VITE_ROSBRIDGE_URL=ws://localhost:9090
# Set to "false" to skip ROS entirely and run on the built-in simulator.
VITE_ROS_ENABLED=true

# Topics
VITE_TOPIC_ODOM=/odom
VITE_TOPIC_CMD_VEL=/cmd_vel
VITE_TOPIC_GOAL=/goal_pose
VITE_TOPIC_POINTS=/points
VITE_TOPIC_CAMERA=/camera/image_raw/compressed
VITE_TOPIC_BATTERY=/battery_state

# Static fallbacks (served from /public)
VITE_CAMERA_VIDEO=media/camera.mp4
VITE_MAP_META=data/map.json
